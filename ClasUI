		logFrame.CanvasPosition = Vector2.new(0, logFrame.CanvasSize.Y.Offset)
		return label
	end
	
	return {
		Frame = consoleFrame,
		Log = log,
		Toggle = function() consoleFrame.Visible = not consoleFrame.Visible end
	}
end

