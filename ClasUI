	-- // ColorPicker
	function tab:CreateColorPicker(name, defaultColor, callback)
		local currentColor = defaultColor or Color3.fromRGB(255, 255, 255)
		local colorFrame = Create("Frame", {
			Parent = tabContent,
			BackgroundColor3 = ActiveTheme.ElementBackground,
			Size = UDim2.new(1, 0, 0, 140),
			LayoutOrder = #tabContent:GetChildren() + 1
		})
		ApplyStroke(colorFrame, ActiveTheme.ElementBorder)

		local label = Create("TextLabel", {
			Parent = colorFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.new(0, 8, 0, 3),
			Text = name,
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})

		-- Preview box
		local preview = Create("Frame", {
			Parent = colorFrame,
			BackgroundColor3 = currentColor,
			Size = UDim2.new(0, 40, 0, 40),
			Position = UDim2.new(0, 8, 0, 24)
		})
		ApplyStroke(preview, ActiveTheme.ElementBorder)

		-- RGB Sliders
		local rSlider, gSlider, bSlider
		local function updateColor()
			local r = rSlider.GetValue()
			local g = gSlider.GetValue()
			local b = bSlider.GetValue()
			currentColor = Color3.fromRGB(r, g, b)
			preview.BackgroundColor3 = currentColor
			if callback then callback(currentColor) end
		end

		-- We'll create sliders manually because we need them inside this frame
		local function makeColorSlider(component, posY, initial)
			local sliderFrame = Create("Frame", {
				Parent = colorFrame,
				BackgroundColor3 = Color3.fromRGB(20, 20, 20),
				Size = UDim2.new(1, -56, 0, 6),
				Position = UDim2.new(0, 56, 0, posY)
			})
			local fill = Create("Frame", {
				Parent = sliderFrame,
				BackgroundColor3 = component,
				Size = UDim2.new(initial / 255, 0, 1, 0)
			})
			local dot = Create("TextButton", {
				Parent = sliderFrame,
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				Size = UDim2.new(0, 10, 0, 10),
				Position = UDim2.new(initial / 255, -5, 0.5, -5),
				Text = "",
				AutoButtonColor = false,
				BorderSizePixel = 0
			})
			local value = initial
			local dragging = false
			local function update(px)
				local rel = math.clamp((px - sliderFrame.AbsolutePosition.X) / sliderFrame.AbsoluteSize.X, 0, 1)
				value = math.floor(rel * 255)
				fill.Size = UDim2.new(rel, 0, 1, 0)
				dot.Position = UDim2.new(rel, -5, 0.5, -5)
				updateColor()
			end
			dot.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
			sliderFrame.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 then
					update(i.Position)
					dragging = true
				end
			end)
			UserInputService.InputChanged:Connect(function(i)
				if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then update(i.Position) end
			end)
			UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
			local api = {GetValue = function() return value end, Set = function(v) value = v; local rel = v/255; fill.Size = UDim2.new(rel,0,1,0); dot.Position = UDim2.new(rel,-5,0.5,-5); updateColor() end}
			return api
		end

		rSlider = makeColorSlider(Color3.fromRGB(255,0,0), 70, defaultColor.R * 255)
		gSlider = makeColorSlider(Color3.fromRGB(0,255,0), 85, defaultColor.G * 255)
		bSlider = makeColorSlider(Color3.fromRGB(0,0,255), 100, defaultColor.B * 255)

		-- Hex input
		local hexBoxBg = Create("Frame", {
			Parent = colorFrame,
			BackgroundColor3 = Color3.fromRGB(20,20,20),
			Size = UDim2.new(0, 80, 0, 20),
			Position = UDim2.new(0, 8, 0, 115)
		})
		ApplyStroke(hexBoxBg, ActiveTheme.ElementBorder)
		local hexBox = Create("TextBox", {
			Parent = hexBoxBg,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 1, 0),
			Position = UDim2.new(0, 4, 0, 0),
			Text = string.format("#%02X%02X%02X", defaultColor.R*255, defaultColor.G*255, defaultColor.B*255),
			PlaceholderText = "#FFFFFF",
			PlaceholderColor3 = Color3.fromRGB(140,140,140),
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.Code,
			TextScaled = true,
			ClearTextOnFocus = false
		})
		hexBox.FocusLost:Connect(function()
			local hex = hexBox.Text:gsub("#", "")
			if #hex == 6 then
				local r = tonumber(hex:sub(1,2), 16) or 255
				local g = tonumber(hex:sub(3,4), 16) or 255
				local b = tonumber(hex:sub(5,6), 16) or 255
				rSlider.Set(r)
				gSlider.Set(g)
				bSlider.Set(b)
			end
		end)

		local api = {
			Set = function(color)
				rSlider.Set(math.floor(color.R * 255))
				gSlider.Set(math.floor(color.G * 255))
				bSlider.Set(math.floor(color.B * 255))
				hexBox.Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255)
			end,
			GetValue = function() return currentColor end,
			Frame = colorFrame
		}
		return api
	end

	return tab
end

-- // Main Library Function
function ClassicUI:CreateWindow(windowName, authorName, customTheme)
