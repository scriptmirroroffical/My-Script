	if customTheme then
		ActiveTheme = customTheme
	else
		ActiveTheme = ClassicUI.Themes.Classic
	end

	local screenGui = CreateScreenGui()
	CreateLoadingScreen(screenGui, windowName, authorName)
	local notificationSystem = CreateNotificationSystem(screenGui)
	local console = CreateConsole(screenGui)
	CreateWatermark(screenGui)

