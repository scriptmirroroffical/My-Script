            Parent = TabContent,
            BackgroundColor3 = UIConfig.ElementColor,
            Size = UDim2.new(1, 0, 0, 50),
            LayoutOrder = #TabContent:GetChildren() + 1
        })
        ApplyStroke(TextboxFrame)
        
        Create("TextLabel", {
            Parent = TextboxFrame,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 0, 18),
            Position = UDim2.new(0, 8, 0, 3),
            Text = TextboxName,
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local TextboxBG = Create("Frame", {
            Parent = TextboxFrame,
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            Size = UDim2.new(1, -16, 0, 24),
            Position = UDim2.new(0, 8, 0, 22)
        })
        ApplyStroke(TextboxBG)
        
        local Textbox = Create("TextBox", {
            Parent = TextboxBG,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -8, 1, 0),
            Position = UDim2.new(0, 4, 0, 0),
            Text = "",
            PlaceholderText = PlaceholderText,
            PlaceholderColor3 = Color3.fromRGB(100, 100, 100),
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false
        })
        
        Textbox.FocusLost:Connect(function(EnterPressed)
            if Callback and EnterPressed then Callback(Textbox.Text) end
        end)
        
        return {
            Frame = TextboxFrame,
            Set = function(Text) Textbox.Text = Text end,
            GetValue = function() return Textbox.Text end
        }
    end
    
    return Tab
end

-- Main Library Function (v1.1 with proxy and built-in Settings tab)
function Library:CreateWindow(WindowName, AuthorName)
    local ScreenGui = CreateScreenGui()
    CreateLoadingScreen(ScreenGui, WindowName, AuthorName)
    local NotificationSystem = CreateNotificationSystem(ScreenGui)
    
    local Window = nil -- will be set after loading
    local WindowReady = false
    local queuedCalls = {}
    
    -- Real window creation (runs after loading)
    task.spawn(function()
        task.wait(2.2) -- loading time
        
        local MainFrame = Create("Frame", {
            Name = "MainWindow",
            Parent = ScreenGui,
            BackgroundColor3 = UIConfig.Background,
            Size = UDim2.new(0, 580, 0, 380),
            Position = UDim2.new(0.5, -290, 0.5, -190),
            Active = true
        })
        ApplyStroke(MainFrame)
        MakeDraggable(MainFrame, MainFrame)
        
        local TitleBar = Create("Frame", {
            Parent = MainFrame,
            BackgroundColor3 = UIConfig.Accent,
            Size = UDim2.new(1, 0, 0, 30)
        })
        
        local TitleLabel = Create("TextLabel", {
            Parent = TitleBar,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            Text = WindowName .. " | " .. AuthorName,
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        -- Version display in title bar
        Create("TextLabel", {
            Parent = TitleBar,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 80, 1, 0),
            Position = UDim2.new(0.5, 0, 0, 0),
            Text = "v" .. Library.Version,
            TextColor3 = Color3.fromRGB(150, 150, 150),
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Center
        })
        
        local CloseButton = Create("TextButton", {
            Parent = TitleBar,
            BackgroundColor3 = Color3.fromRGB(200, 50, 50),
            Size = UDim2.new(0, 30, 1, 0),
            Position = UDim2.new(1, -30, 0, 0),
            Text = "X",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Font = Enum.Font.Code,
            TextScaled = true,
            AutoButtonColor = false
        })
        CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)
        
        local TabHolder = Create("Frame", {
            Parent = MainFrame,
            BackgroundColor3 = Color3.fromRGB(30, 30, 30),
            Size = UDim2.new(0, 140, 1, -30),
            Position = UDim2.new(0, 0, 0, 30)
        })
        
        Create("UIListLayout", {
            Parent = TabHolder,
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder
        })
        
        local ContentFrame = Create("Frame", {
            Parent = MainFrame,
            BackgroundColor3 = UIConfig.Background,
            Size = UDim2.new(1, -142, 0, 380 - 32),
            Position = UDim2.new(0, 141, 0, 31)
        })
        
        Window = {
            Frame = MainFrame,
            TabHolder = TabHolder,
            ContentFrame = ContentFrame,
            NotificationSystem = NotificationSystem
        }
        
        function Window:CreateTab(TabName, TabIcon)
            return CreateTab(Window, TabName, TabIcon)
        end
        
        function Window:Notify(Title, Content, Duration)
            NotificationSystem.Send(Title, Content, Duration)
        end
        
        -- Automatically create Settings tab with version display
        local SettingsTab = CreateTab(Window, "Settings", "⚙")
        SettingsTab:CreateSection("Information")
        SettingsTab:CreateLabel("Library: ClassicUI")
        SettingsTab:CreateLabel("Version: " .. Library.Version)
        SettingsTab:CreateLabel("Author: UniqueDev")
        SettingsTab:CreateSection("UI")
        SettingsTab:CreateToggle("Show UI", true, function(Value)
            MainFrame.Visible = Value
        end)
        
        -- Set ready and process queued calls
        WindowReady = true
        Library.ActiveWindow = Window
        for _, call in ipairs(queuedCalls) do
            local method = Window[call.method]
            if method then
                local result = method(Window, table.unpack(call.args))
                if call.callback then call.callback(result) end
            end
        end
        queuedCalls = nil
    end)
    
    -- Proxy object that queues methods until window is ready
    local ProxyWindow = {}
    local function QueueCall(method, ...)
        local args = {...}
        local callback = nil
        if type(args[#args]) == "function" then
            callback = args[#args]
            args[#args] = nil
        end
        if WindowReady and Window then
            local func = Window[method]
            if func then
                local result = func(Window, table.unpack(args))
                if callback then callback(result) end
                return result
            end
        else
            table.insert(queuedCalls, {method = method, args = args, callback = callback})
        end
    end
    
    ProxyWindow.CreateTab = function(...) return QueueCall("CreateTab", ...) end
    ProxyWindow.Notify = function(...) return QueueCall("Notify", ...) end
    ProxyWindow.Window = Window  -- will be nil until ready, but updated by reference
    
    return ProxyWindow
end

return Library
