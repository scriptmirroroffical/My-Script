			return btn
		end

		addTitleButton("-", Color3.fromRGB(200, 200, 50), UDim2.new(1, -82, 0, 0), function()
			mainFrame.Visible = false
		end)
		addTitleButton("□", Color3.fromRGB(50, 200, 50), UDim2.new(1, -56, 0, 0), function()
			mainFrame.Size = mainFrame.Size == UDim2.new(0, 620, 0, 420) and UDim2.new(0, 300, 0, 200) or UDim2.new(0, 620, 0, 420)
		end)
