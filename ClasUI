		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 30),
		Position = UDim2.new(0, 10, 0, 10),
		Text = hubName or "ClassicUI",
		TextColor3 = ActiveTheme.TextColor,
		Font = Enum.Font.SourceSansBold,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	-- Author
	Create("TextLabel", {
		Parent = frame,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.new(0, 10, 0, 42),
		Text = "by " .. (authorName or "Unknown"),
		TextColor3 = Color3.fromRGB(180, 180, 180),
		Font = Enum.Font.SourceSans,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	-- Version
	Create("TextLabel", {
		Parent = frame,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.new(0, 10, 0, 64),
		Text = "v" .. ClassicUI.Version,
		TextColor3 = Color3.fromRGB(150, 150, 150),
		Font = Enum.Font.SourceSans,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	-- Separator
	Create("Frame", {
		Parent = frame,
		BackgroundColor3 = ActiveTheme.AccentColor,
		Size = UDim2.new(1, -20, 0, 2),
		Position = UDim2.new(0, 10, 0, 88)
	})

	-- Loading text with spinning symbol
	local progressText = Create("TextLabel", {
		Parent = frame,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 25),
		Position = UDim2.new(0, 10, 0, 100),
		Text = "- \\ Loading...",
		TextColor3 = Color3.fromRGB(180, 255, 180),
		Font = Enum.Font.SourceSans,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center
	})

	-- Progress bar
	local barBg = Create("Frame", {
		Parent = frame,
		BackgroundColor3 = Color3.fromRGB(20, 20, 20),
		Size = UDim2.new(1, -40, 0, 14),
		Position = UDim2.new(0, 20, 0, 130)
	})
	ApplyStroke(barBg, ActiveTheme.ElementBorder)

	local barFill = Create("Frame", {
		Parent = barBg,
		BackgroundColor3 = ActiveTheme.AccentColor,
		Size = UDim2.new(0, 0, 1, 0)
	})

	local symbols = {"-", "\\", "|", "/"}
	local idx = 1
	local progress = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		idx = idx + 1; if idx > #symbols then idx = 1 end
		progressText.Text = symbols[idx] .. " Loading... " .. math.floor(progress * 100) .. "%"
		progress = math.min(progress + dt * 0.4, 1)
		barFill.Size = UDim2.new(progress, 0, 1, 0)
		if progress >= 1 then
			progressText.Text = "- Done -"
			task.wait(0.5)
			conn:Disconnect()
			frame:Destroy()
		end
	end)
end

-- // Notification System
local function CreateNotificationSystem(screenGui)
	local holder = Create("Frame", {
		Parent = screenGui,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 260, 1, -20),
		Position = UDim2.new(0, 10, 0, 10),
		ZIndex = 100
	})
	local notifications = {}
	local function send(title, message, duration)
		duration = duration or 3
		local notifFrame = Create("Frame", {
			Parent = holder,
			BackgroundColor3 = ActiveTheme.NotificationBackground,
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.new(0, 0, 0, 0),
			ClipsDescendants = true,
			ZIndex = 100
		})
		ApplyStroke(notifFrame, ActiveTheme.ElementBorder)
		-- Title
		Create("TextLabel", {
			Parent = notifFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 20),
			Position = UDim2.new(0, 5, 0, 3),
			Text = title or "Notification",
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.SourceSansBold,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 100
		})
		-- Message
		Create("TextLabel", {
			Parent = notifFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 16),
			Position = UDim2.new(0, 5, 0, 24),
			Text = message or "",
			TextColor3 = Color3.fromRGB(180, 180, 180),
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			ZIndex = 100
		})
		notifFrame.Size = UDim2.new(1, 0, 0, 50)
		-- Reposition existing
		for i, n in ipairs(notifications) do
			Tween(n.Frame, {Position = UDim2.new(0, 0, 0, (i-1) * 55 + 5)})
		end
		table.insert(notifications, 1, {Frame = notifFrame})
		-- Auto dismiss
		task.delay(duration, function()
			local fade = TweenService:Create(notifFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1})
			fade:Play()
			fade.Completed:Wait()
			for i, v in ipairs(notifications) do
				if v.Frame == notifFrame then
					table.remove(notifications, i)
					break
				end
			end
			notifFrame:Destroy()
			for i, n in ipairs(notifications) do
				Tween(n.Frame, {Position = UDim2.new(0, 0, 0, (i-1) * 55 + 5)})
			end
		end)
		return notifFrame
	end
	return {Send = send}
end

