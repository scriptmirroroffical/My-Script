    })
    
    -- Separator
    local Separator = Create("Frame", {
        Parent = LoadingFrame,
        BackgroundColor3 = UIConfig.Accent,
        Size = UDim2.new(1, -20, 0, 1),
        Position = UDim2.new(0, 10, 0, 72)
    })
    
    -- Loading progress text
    local ProgressText = Create("TextLabel", {
        Name = "ProgressText",
        Parent = LoadingFrame,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 10, 0, 78),
        Text = [[- \ Loading...]],
        TextColor3 = Color3.fromRGB(100, 255, 100),
        TextScaled = true,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Center
    })
    
    -- Progress Bar
    local ProgressBarBG = Create("Frame", {
        Parent = LoadingFrame,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        Size = UDim2.new(1, -40, 0, 12),
        Position = UDim2.new(0, 20, 0, 103)
    })
    ApplyStroke(ProgressBarBG)
    
    local ProgressBarFill = Create("Frame", {
        Name = "ProgressBarFill",
        Parent = ProgressBarBG,
        BackgroundColor3 = Color3.fromRGB(100, 255, 100),
        Size = UDim2.new(0, 0, 1, 0)
    })
    
    local symbols = {"-", "\\", "|", "/"}
    local symbolIndex = 1
    local progressValue = 0
    local LoadingConnection
    
    LoadingConnection = RunService.RenderStepped:Connect(function(deltaTime)
        symbolIndex = symbolIndex + 1
        if symbolIndex > #symbols then symbolIndex = 1 end
        ProgressText.Text = symbols[symbolIndex] .. " Loading... " .. math.floor(progressValue * 100) .. "%"
        
        progressValue = math.min(progressValue + deltaTime * 0.4, 1)
        ProgressBarFill.Size = UDim2.new(progressValue, 0, 1, 0)
        
        if progressValue >= 1 then
            ProgressText.Text = "- Done -"
            task.wait(0.5)
            LoadingConnection:Disconnect()
            LoadingFrame:Destroy()
        end
    end)
    
    return LoadingFrame
end

-- Notification System
local function CreateNotificationSystem(ScreenGui)
    local NotificationHolder = Create("Frame", {
        Name = "NotificationHolder",
        Parent = ScreenGui,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 250, 1, -20),
        Position = UDim2.new(0, 10, 0, 10)
    })
    
    local Notifications = {}
    
    local function SendNotification(Title, Content, Duration)
        Duration = Duration or 3
        
        local NotificationFrame = Create("Frame", {
            Parent = NotificationHolder,
            BackgroundColor3 = UIConfig.Background,
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 0, 0),
            ClipsDescendants = true
        })
        ApplyStroke(NotificationFrame)
        
        local TitleLabel = Create("TextLabel", {
            Parent = NotificationFrame,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -10, 0, 18),
            Position = UDim2.new(0, 5, 0, 3),
            Text = Title or "Notification",
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local ContentLabel = Create("TextLabel", {
            Parent = NotificationFrame,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -10, 0, 14),
            Position = UDim2.new(0, 5, 0, 22),
            Text = Content or "",
            TextColor3 = Color3.fromRGB(150, 150, 150),
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true
        })
        
        NotificationFrame.Size = UDim2.new(1, 0, 0, 45)
        
        -- Reposition existing notifications
        for i, Notif in ipairs(Notifications) do
            local targetPos = UDim2.new(0, 0, 0, (i-1) * 50 + 5)
            TweenService:Create(Notif.Frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        end
        
        local NotifData = {Frame = NotificationFrame}
        table.insert(Notifications, 1, NotifData)
        
        task.spawn(function()
            task.wait(Duration)
            local fadeTween = TweenService:Create(NotificationFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1
            })
            fadeTween:Play()
            fadeTween.Completed:Wait()
            
            for i, v in ipairs(Notifications) do
                if v.Frame == NotificationFrame then
                    table.remove(Notifications, i)
                    break
                end
            end
            
            NotificationFrame:Destroy()
            
            for i, Notif in ipairs(Notifications) do
                local targetPos = UDim2.new(0, 0, 0, (i-1) * 50 + 5)
                TweenService:Create(Notif.Frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
            end
        end)
        
        return NotificationFrame
    end
    
    return { Send = SendNotification }
end

