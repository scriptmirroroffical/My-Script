            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Text = ButtonName,
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true
        })
        
        ButtonFrame.MouseButton1Click:Connect(function()
            if Callback then Callback() end
        end)
        
        ButtonFrame.MouseEnter:Connect(function()
            TweenService:Create(ButtonFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = UIConfig.Accent}):Play()
        end)
        ButtonFrame.MouseLeave:Connect(function()
            TweenService:Create(ButtonFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundColor3 = UIConfig.ElementColor}):Play()
        end)
        
        return { Frame = ButtonFrame }
    end
    
    -- Slider
    function Tab:CreateSlider(SliderName, MinValue, MaxValue, DefaultValue, Callback)
        MinValue = MinValue or 0
        MaxValue = MaxValue or 100
        DefaultValue = DefaultValue or MinValue
        local SliderValue = DefaultValue
        local IsDragging = false
        
        local SliderFrame = Create("Frame", {
            Parent = TabContent,
            BackgroundColor3 = UIConfig.ElementColor,
            Size = UDim2.new(1, 0, 0, 55),
            LayoutOrder = #TabContent:GetChildren() + 1
        })
        ApplyStroke(SliderFrame)
        
        local SliderLabel = Create("TextLabel", {
            Parent = SliderFrame,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 0, 18),
            Position = UDim2.new(0, 8, 0, 3),
            Text = SliderName .. ": " .. DefaultValue,
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local SliderBG = Create("Frame", {
            Parent = SliderFrame,
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            Size = UDim2.new(1, -16, 0, 6),
            Position = UDim2.new(0, 8, 0, 30)
        })
        
        local SliderFill = Create("Frame", {
            Parent = SliderBG,
            BackgroundColor3 = UIConfig.Accent,
            Size = UDim2.new((DefaultValue - MinValue) / (MaxValue - MinValue), 0, 1, 0)
        })
        
        local SliderDot = Create("TextButton", {
            Parent = SliderBG,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new((DefaultValue - MinValue) / (MaxValue - MinValue), -6, 0.5, -6),
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0
        })
        
        local function UpdateSlider(Position)
            local RelativeX = math.clamp((Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
            SliderValue = math.floor(MinValue + (MaxValue - MinValue) * RelativeX)
            SliderFill.Size = UDim2.new(RelativeX, 0, 1, 0)
            SliderDot.Position = UDim2.new(RelativeX, -6, 0.5, -6)
            SliderLabel.Text = SliderName .. ": " .. SliderValue
            if Callback then Callback(SliderValue) end
        end
        
        SliderDot.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then IsDragging = true end
        end)
        SliderBG.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then UpdateSlider(Input.Position); IsDragging = true end
        end)
        UserInputService.InputChanged:Connect(function(Input)
            if IsDragging and Input.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(Input.Position) end
        end)
        UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then IsDragging = false end
        end)
        
        return {
            Frame = SliderFrame,
            Set = function(Value)
                SliderValue = math.clamp(Value, MinValue, MaxValue)
                local RelativeX = (SliderValue - MinValue) / (MaxValue - MinValue)
                SliderFill.Size = UDim2.new(RelativeX, 0, 1, 0)
                SliderDot.Position = UDim2.new(RelativeX, -6, 0.5, -6)
                SliderLabel.Text = SliderName .. ": " .. SliderValue
            end,
            GetValue = function() return SliderValue end
        }
    end
    
    -- Dropdown
