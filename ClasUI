    ApplyStroke(TabButton)
    
    local TabLabel = Create("TextLabel", {
        Parent = TabButton,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        Text = (TabIcon and TabIcon .. " " or "") .. TabName,
        TextColor3 = UIConfig.TextColor,
        Font = Enum.Font.Code,
        TextScaled = true,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    
    -- Tab Content
    local TabContent = Create("ScrollingFrame", {
        Parent = ContentFrame,
        BackgroundColor3 = UIConfig.Background,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = UIConfig.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0)
    })
    
    local UIListLayout = Create("UIListLayout", {
        Parent = TabContent,
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder
    })
    
    Create("UIPadding", {
        Parent = TabContent,
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, 5)
    })
    
    TabContent.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.UIListLayout.AbsoluteContentSize.Y + 10)
    end)
    
    -- Tab selection
    TabButton.MouseButton1Click:Connect(function()
        for _, child in ipairs(TabHolder:GetChildren()) do
            if child:IsA("TextButton") then child.BackgroundColor3 = UIConfig.ElementColor end
        end
        for _, child in ipairs(ContentFrame:GetChildren()) do
            if child:IsA("ScrollingFrame") then child.Visible = false end
        end
        TabButton.BackgroundColor3 = UIConfig.Accent
        TabContent.Visible = true
    end)
    
    -- Auto-select first tab
    if #TabHolder:GetChildren() == 1 then
        TabButton.BackgroundColor3 = UIConfig.Accent
        TabContent.Visible = true
    end
    
    -- Tab API object
    local Tab = { Button = TabButton, Content = TabContent }
    
