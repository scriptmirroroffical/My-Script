		ApplyStroke(optionsFrame, ActiveTheme.ElementBorder)
		local optionsList = Create("UIListLayout", {
			Parent = optionsFrame,
			SortOrder = Enum.SortOrder.LayoutOrder
		})

		local function rebuild()
			for _, b in ipairs(optionButtons) do b:Destroy() end
			optionButtons = {}
			for _, opt in ipairs(options) do
				local optBtn = Create("TextButton", {
					Parent = optionsFrame,
					BackgroundColor3 = ActiveTheme.ElementBackground,
					Size = UDim2.new(1, 0, 0, 24),
					Text = opt,
					TextColor3 = ActiveTheme.TextColor,
					Font = Enum.Font.SourceSans,
					TextScaled = true,
					AutoButtonColor = false,
					ZIndex = 10
				})
				optBtn.MouseButton1Click:Connect(function()
					selected = opt
					label.Text = name .. ": " .. opt
					open = false
					Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)
					Tween(arrow, {Rotation = 0}, 0.15)
					if callback then callback(opt) end
				end)
				optBtn.MouseEnter:Connect(function()
					Tween(optBtn, {BackgroundColor3 = ActiveTheme.TabButtonActive}, 0.2)
				end)
				optBtn.MouseLeave:Connect(function()
					Tween(optBtn, {BackgroundColor3 = ActiveTheme.ElementBackground}, 0.15)
				end)
				table.insert(optionButtons, optBtn)
			end
		end

		mainBtn.MouseButton1Click:Connect(function()
			open = not open
			if open then
				Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, #options * 24)}, 0.25)
				Tween(arrow, {Rotation = 90}, 0.25)
			else
				Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)
				Tween(arrow, {Rotation = 0}, 0.15)
			end
		end)

		rebuild()
		local api = {
			Refresh = function(newOpts)
				options = newOpts
				rebuild()
			end,
			Set = function(v)
				selected = v
				label.Text = name .. ": " .. v
			end,
			GetValue = function() return selected end
		}
		return api
	end

