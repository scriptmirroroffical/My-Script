	-- // Slider
	function tab:CreateSlider(name, min, max, default, callback)
		min = min or 0
		max = max or 100
		default = default or min
		local value = default
		local dragging = false
		local sliderFrame = Create("Frame", {
			Parent = tabContent,
			BackgroundColor3 = ActiveTheme.ElementBackground,
			Size = UDim2.new(1, 0, 0, 50),
			LayoutOrder = #tabContent:GetChildren() + 1
		})
		ApplyStroke(sliderFrame, ActiveTheme.ElementBorder)

		local label = Create("TextLabel", {
			Parent = sliderFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.new(0, 8, 0, 3),
			Text = name .. ": " .. default,
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})

		local bg = Create("Frame", {
			Parent = sliderFrame,
			BackgroundColor3 = Color3.fromRGB(20, 20, 20),
			Size = UDim2.new(1, -16, 0, 6),
			Position = UDim2.new(0, 8, 0, 30)
		})

		local fill = Create("Frame", {
			Parent = bg,
			BackgroundColor3 = ActiveTheme.SliderFillColor,
			Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
		})

		local dot = Create("TextButton", {
			Parent = bg,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Size = UDim2.new(0, 10, 0, 10),
			Position = UDim2.new((default - min) / (max - min), -5, 0.5, -5),
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0
		})

		local function update(px)
			local rel = math.clamp((px - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
			value = math.floor(min + (max - min) * rel)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			dot.Position = UDim2.new(rel, -5, 0.5, -5)
			label.Text = name .. ": " .. value
			if callback then callback(value) end
		end

		dot.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
		end)
		bg.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				update(input.Position)
				dragging = true
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				update(input.Position)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end)

		local api = {
			Set = function(v)
				value = math.clamp(v, min, max)
				local rel = (value - min) / (max - min)
				fill.Size = UDim2.new(rel, 0, 1, 0)
				dot.Position = UDim2.new(rel, -5, 0.5, -5)
				label.Text = name .. ": " .. value
			end,
			GetValue = function() return value end
		}
		return api
	end

