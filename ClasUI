-- // Main Tab System
local function CreateTab(window, tabName, tabIcon)
	local tabHolder = window.TabHolder
	local contentFrame = window.ContentFrame

	local tabButton = Create("TextButton", {
		Parent = tabHolder,
		BackgroundColor3 = ActiveTheme.TabButtonColor,
		Size = UDim2.new(1, -10, 0, 28),
		Position = UDim2.new(0, 5, 0, #tabHolder:GetChildren() * 30 + 5),
		Text = "",
		AutoButtonColor = false
	})
	ApplyStroke(tabButton, ActiveTheme.ElementBorder)
	MakeDraggable(tabButton, tabButton) -- not needed but ok

	local tabLabel = Create("TextLabel", {
		Parent = tabButton,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		Text = (tabIcon and tabIcon .. " " or "") .. (tabName or "Tab"),
		TextColor3 = ActiveTheme.TextColor,
		Font = Enum.Font.SourceSans,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local tabContent = Create("ScrollingFrame", {
		Parent = contentFrame,
		BackgroundColor3 = ActiveTheme.WindowBackground,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = ActiveTheme.ScrollBarColor,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		BorderSizePixel = 0
	})
	local listLayout = Create("UIListLayout", {
		Parent = tabContent,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder
	})
	Create("UIPadding", {
		Parent = tabContent,
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 6)
	})
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		tabContent.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 12)
	end)

	-- Tab selection logic
	tabButton.MouseButton1Click:Connect(function()
		for _, child in ipairs(tabHolder:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = ActiveTheme.TabButtonColor
			end
		end
		for _, child in ipairs(contentFrame:GetChildren()) do
			if child:IsA("ScrollingFrame") then
				child.Visible = false
			end
		end
		tabButton.BackgroundColor3 = ActiveTheme.TabButtonActive
		tabContent.Visible = true
	end)

	-- Select first tab automatically
	if #tabHolder:GetChildren() == 1 then
		tabButton.BackgroundColor3 = ActiveTheme.TabButtonActive
		tabContent.Visible = true
	end

	local tab = {Button = tabButton, Content = tabContent, Window = window}

	-- // Section
	function tab:CreateSection(name)
		local section = Create("Frame", {
			Parent = tabContent,
			BackgroundColor3 = ActiveTheme.ElementBackground,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = #tabContent:GetChildren() + 1
		})
		ApplyStroke(section, ActiveTheme.ElementBorder)
		Create("TextLabel", {
			Parent = section,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			Text = name,
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.SourceSansBold,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})
	end

	-- // Toggle
	function tab:CreateToggle(name, default, callback)
		local value = default or false
		local toggleFrame = Create("Frame", {
			Parent = tabContent,
			BackgroundColor3 = ActiveTheme.ElementBackground,
			Size = UDim2.new(1, 0, 0, 38),
			LayoutOrder = #tabContent:GetChildren() + 1
		})
		ApplyStroke(toggleFrame, ActiveTheme.ElementBorder)

		local label = Create("TextLabel", {
			Parent = toggleFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.7, 0, 1, 0),
			Position = UDim2.new(0, 8, 0, 0),
			Text = name,
			TextColor3 = ActiveTheme.TextColor,
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})

		local button = Create("TextButton", {
			Parent = toggleFrame,
			BackgroundColor3 = value and ActiveTheme.ToggleOnColor or ActiveTheme.ToggleOffColor,
			Size = UDim2.new(0, 34, 0, 16),
			Position = UDim2.new(1, -44, 0.5, -8),
			Text = "",
			AutoButtonColor = false
		})
		ApplyStroke(button, ActiveTheme.ElementBorder)

		local dot = Create("Frame", {
			Parent = button,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Size = UDim2.new(0, 12, 0, 12),
			Position = value and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
			BorderSizePixel = 0
		})

		local function set(v)
			value = v
			local col = v and ActiveTheme.ToggleOnColor or ActiveTheme.ToggleOffColor
			local pos = v and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
			Tween(button, {BackgroundColor3 = col}, 0.2)
