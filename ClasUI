        local IsOpen = false
        local OptionButtons = {}
        
        local DropdownFrame = Create("Frame", {
            Parent = TabContent,
            BackgroundColor3 = UIConfig.ElementColor,
            Size = UDim2.new(1, 0, 0, 35),
            LayoutOrder = #TabContent:GetChildren() + 1,
            ClipsDescendants = false
        })
        ApplyStroke(DropdownFrame)
        
        local DropdownButton = Create("TextButton", {
            Parent = DropdownFrame,
            BackgroundColor3 = UIConfig.ElementColor,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            AutoButtonColor = false
        })
        
        local DropdownLabel = Create("TextLabel", {
            Parent = DropdownButton,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.85, 0, 1, 0),
            Position = UDim2.new(0, 8, 0, 0),
            Text = DropdownName .. ": " .. SelectedOption,
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left
        })
        
        local ArrowLabel = Create("TextLabel", {
            Parent = DropdownButton,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(1, -25, 0, 0),
            Text = ">",
            TextColor3 = UIConfig.TextColor,
            Font = Enum.Font.Code,
            TextScaled = true
        })
        
        local OptionsFrame = Create("Frame", {
            Parent = DropdownFrame,
            BackgroundColor3 = UIConfig.ElementColor,
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 1, 0),
            ClipsDescendants = true,
            ZIndex = 10
        })
        ApplyStroke(OptionsFrame)
        
        local OptionsList = Create("UIListLayout", {
            Parent = OptionsFrame,
            SortOrder = Enum.SortOrder.LayoutOrder
        })
        
        local function RebuildOptions()
            for _, btn in ipairs(OptionButtons) do btn:Destroy() end
            OptionButtons = {}
            for _, opt in ipairs(Options) do
                local optBtn = Create("TextButton", {
                    Parent = OptionsFrame,
                    BackgroundColor3 = UIConfig.ElementColor,
                    Size = UDim2.new(1, 0, 0, 25),
                    Text = opt,
                    TextColor3 = UIConfig.TextColor,
                    Font = Enum.Font.Code,
                    TextScaled = true,
                    AutoButtonColor = false,
                    ZIndex = 10
                })
                optBtn.MouseButton1Click:Connect(function()
                    SelectedOption = opt
                    DropdownLabel.Text = DropdownName .. ": " .. opt
                    IsOpen = false
                    TweenService:Create(OptionsFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                    TweenService:Create(ArrowLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Rotation = 0}):Play()
                    if Callback then Callback(opt) end
                end)
                optBtn.MouseEnter:Connect(function()
                    TweenService:Create(optBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = UIConfig.Accent}):Play()
                end)
                optBtn.MouseLeave:Connect(function()
                    TweenService:Create(optBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundColor3 = UIConfig.ElementColor}):Play()
                end)
                table.insert(OptionButtons, optBtn)
            end
        end
        
        DropdownButton.MouseButton1Click:Connect(function()
            IsOpen = not IsOpen
            if IsOpen then
                TweenService:Create(OptionsFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, #Options * 25)}):Play()
                TweenService:Create(ArrowLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 90}):Play()
            else
                TweenService:Create(OptionsFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                TweenService:Create(ArrowLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Rotation = 0}):Play()
            end
        end)
        
        RebuildOptions()
        
        return {
            Frame = DropdownFrame,
            Refresh = function(NewOptions)
                Options = NewOptions
                RebuildOptions()
            end,
            Set = function(Value)
                SelectedOption = Value
                DropdownLabel.Text = DropdownName .. ": " .. Value
            end,
            GetValue = function() return SelectedOption end
        }
    end
    
