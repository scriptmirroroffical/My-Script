			console.Toggle()
		end

		-- Built-in Settings tab
		local settingsTab = CreateTab(window, "Settings", "⚙")
		settingsTab:CreateSection("Information")
		settingsTab:CreateLabel("ClassicUI v" .. ClassicUI.Version)
		settingsTab:CreateLabel("Author: " .. ClassicUI.Author)
		settingsTab:CreateLabel("Theme: " .. ActiveTheme.Name)
		settingsTab:CreateSection("Appearance")
		local themeDropdown = settingsTab:CreateDropdown("Theme", {"Classic", "Dark", "Light", "OldRoblox"}, function(choice)
			window:SetTheme(choice)
		end)
		themeDropdown.Set(ActiveTheme.Name)
		settingsTab:CreateToggle("Show UI", true, function(v) window.Frame.Visible = v end)
		settingsTab:CreateButton("Toggle Console", function() console.Toggle() end)

		windowReady = true
		ClassicUI.ActiveWindow = window
	end)

	repeat task.wait() until windowReady
	return window
end

return ClassicUI
