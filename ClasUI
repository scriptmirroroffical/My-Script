local ClassicUI = {
	Version = "1.3",
	Author = "ScriptMirrorOffical",
	ActiveWindow = nil
}

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui") or game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

-- Theme
local Theme = {
	Background = Color3.fromRGB(40, 40, 40),
	TitleBar = Color3.fromRGB(30, 30, 30),
	TabBar = Color3.fromRGB(35, 35, 35),
	Element = Color3.fromRGB(50, 50, 50),
	ElementBorder = Color3.fromRGB(90, 90, 90),
	Text = Color3.fromRGB(230, 230, 230),
	Accent = Color3.fromRGB(0, 120, 255),
	ToggleOn = Color3.fromRGB(60, 200, 60),
	ToggleOff = Color3.fromRGB(120, 120, 120),
	SliderFill = Color3.fromRGB(0, 120, 255)
}

-- Utility
local function Create(Class, Props)
	local obj = Instance.new(Class)
	for k, v in pairs(Props or {}) do
		obj[k] = v
	end
	return obj
end

local function Stroke(obj, color)
	obj.BorderSizePixel = 1
	obj.BorderColor3 = color or Theme.ElementBorder
end

local function MakeDraggable(gui, dragObj)
	dragObj = dragObj or gui
	local dragging, startPos, dragStart
	dragObj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragObj.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			gui.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

-- Notice (top-right loading indicator) – exactly as requested
local function CreateNotice(playerGui, text)
	local noticeGui = Create("ScreenGui", {
		Name = "Notice",
		Parent = playerGui,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	})
	local label = Create("TextLabel", {
		Parent = noticeGui,
		TextWrapped = true,
		BorderSizePixel = 0,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextScaled = true,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 1,
		FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		TextColor3 = Color3.fromRGB(255, 255, 255), -- white on transparent better for visibility
		Size = UDim2.new(0.42502, 0, 0.04591, 0),
		BorderColor3 = Color3.fromRGB(0, 0, 0),
		Text = text or "- Loading [NameHub] [By Person]",
		Position = UDim2.new(0.57463, 0, 0.05903, 0)
	})
	return noticeGui, label
end

-- Loading sequence (updates notice label with spinning symbol)
local function StartLoading(playerGui, hubName, authorName)
	local noticeGui, noticeLabel = CreateNotice(playerGui, "- \\ Loading ["..hubName.."] ["..authorName.."]")
	local symbols = {"-", "\\", "|", "/"}
	local idx = 1
	local conn
	conn = RunService.RenderStepped:Connect(function()
		idx = idx + 1; if idx > #symbols then idx = 1 end
		noticeLabel.Text = symbols[idx] .. " Loading ["..hubName.."] ["..authorName.."]"
	end)
	return noticeGui, conn
end

-- Main UI ScreenGui
local function CreateScreenGui()
	if CoreGui:FindFirstChild("ClassicUI_Main") then
		CoreGui:FindFirstChild("ClassicUI_Main"):Destroy()
	end
	local gui = Create("ScreenGui", {
		Name = "ClassicUI_Main",
		Parent = CoreGui,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true
	})
	return gui
end

-- Window
function ClassicUI:CreateWindow(hubName, authorName)
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	-- Start loading notice
	local noticeGui, noticeConn = StartLoading(playerGui, hubName, authorName)

	-- Wait a bit for loading effect
	task.wait(2)
	-- Stop notice and remove it
	noticeConn:Disconnect()
	noticeGui:Destroy()

	-- Create main UI
	local screenGui = CreateScreenGui()

	-- Main Window
	local main = Create("Frame", {
		Parent = screenGui,
		BackgroundColor3 = Theme.Background,
		Size = UDim2.new(0, 540, 0, 350),
		Position = UDim2.new(0.5, -270, 0.5, -175),
		Active = true
	})
	Stroke(main)
	MakeDraggable(main, main)

	-- Title Bar
	local titleBar = Create("Frame", {
		Parent = main,
		BackgroundColor3 = Theme.TitleBar,
		Size = UDim2.new(1, 0, 0, 28)
	})

	Create("TextLabel", {
		Parent = titleBar,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		Text = hubName .. " | " .. authorName,
		TextColor3 = Theme.Text,
		Font = Enum.Font.SourceSansBold,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	Create("TextLabel", {
		Parent = titleBar,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 70, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Text = "v" .. ClassicUI.Version,
		TextColor3 = Color3.fromRGB(180, 180, 180),
		Font = Enum.Font.SourceSans,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center
	})

	local closeBtn = Create("TextButton", {
		Parent = titleBar,
		BackgroundColor3 = Color3.fromRGB(200, 60, 60),
		Size = UDim2.new(0, 26, 1, 0),
		Position = UDim2.new(1, -26, 0, 0),
		Text = "X",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.SourceSansBold,
		TextScaled = true,
		AutoButtonColor = false
	})
	closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

	-- Tab holder
	local tabHolder = Create("Frame", {
		Parent = main,
		BackgroundColor3 = Theme.TabBar,
		Size = UDim2.new(0, 130, 1, -28),
		Position = UDim2.new(0, 0, 0, 28)
	})
	Create("UIListLayout", {
		Parent = tabHolder,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder
	})

	-- Content area
	local content = Create("Frame", {
		Parent = main,
		BackgroundColor3 = Theme.Background,
		Size = UDim2.new(1, -132, 1, -30),
		Position = UDim2.new(0, 131, 0, 29)
	})

	-- Notification system
	local notifHolder = Create("Frame", {
		Parent = screenGui,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 240, 1, -20),
		Position = UDim2.new(0, 10, 0, 10),
		ZIndex = 100
	})
	local notifs = {}
	local function Notify(title, msg, dur)
		dur = dur or 3
		local nFrame = Create("Frame", {
			Parent = notifHolder,
			BackgroundColor3 = Theme.Background,
			Size = UDim2.new(1, 0, 0, 0),
			ClipsDescendants = true,
			ZIndex = 100
		})
		Stroke(nFrame)
		Create("TextLabel", {
			Parent = nFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 18),
			Position = UDim2.new(0, 5, 0, 3),
			Text = title,
			TextColor3 = Theme.Text,
			Font = Enum.Font.SourceSansBold,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})
		Create("TextLabel", {
			Parent = nFrame,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 14),
			Position = UDim2.new(0, 5, 0, 22),
			Text = msg,
			TextColor3 = Color3.fromRGB(180, 180, 180),
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true
		})
		nFrame.Size = UDim2.new(1, 0, 0, 45)
		-- reposition
		for i, n in ipairs(notifs) do
			TweenService:Create(n.Frame, TweenInfo.new(0.2), {Position = UDim2.new(0, 0, 0, (i-1)*50+5)}):Play()
		end
		table.insert(notifs, 1, {Frame = nFrame})
		task.delay(dur, function()
			local fade = TweenService:Create(nFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1})
			fade:Play()
			fade.Completed:Wait()
			for i, v in ipairs(notifs) do
				if v.Frame == nFrame then table.remove(notifs, i); break end
			end
			nFrame:Destroy()
			for i, n in ipairs(notifs) do
				TweenService:Create(n.Frame, TweenInfo.new(0.2), {Position = UDim2.new(0, 0, 0, (i-1)*50+5)}):Play()
			end
		end)
	end

	-- Tab creation
	local function CreateTab(name, icon)
		local tabBtn = Create("TextButton", {
			Parent = tabHolder,
			BackgroundColor3 = Theme.Element,
			Size = UDim2.new(1, -10, 0, 26),
			Position = UDim2.new(0, 5, 0, #tabHolder:GetChildren() * 28 + 5),
			Text = "",
			AutoButtonColor = false
		})
		Stroke(tabBtn)
		Create("TextLabel", {
			Parent = tabBtn,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			Text = (icon and icon.." " or "") .. name,
			TextColor3 = Theme.Text,
			Font = Enum.Font.SourceSans,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left
		})

		local page = Create("ScrollingFrame", {
			Parent = content,
			BackgroundColor3 = Theme.Background,
			Size = UDim2.new(1, 0, 1, 0),
			Visible = false,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Theme.ElementBorder,
			BorderSizePixel = 0
		})
		local layout = Create("UIListLayout", {
			Parent = page,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder
		})
		Create("UIPadding", {Parent = page, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 5)})
		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
		end)

		tabBtn.MouseButton1Click:Connect(function()
			for _, b in ipairs(tabHolder:GetChildren()) do if b:IsA("TextButton") then b.BackgroundColor3 = Theme.Element end end
			for _, p in ipairs(content:GetChildren()) do if p:IsA("ScrollingFrame") then p.Visible = false end end
			tabBtn.BackgroundColor3 = Theme.Accent
			page.Visible = true
		end)
		if #tabHolder:GetChildren() == 1 then tabBtn.BackgroundColor3 = Theme.Accent; page.Visible = true end

		local tab = {}

		-- Section
		function tab:CreateSection(title)
			local sec = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = #page:GetChildren()+1})
			Stroke(sec)
			Create("TextLabel", {Parent = sec, BackgroundTransparency = 1, Size = UDim2.new(1, -10, 1, 0), Position = UDim2.new(0, 10, 0, 0), Text = title, TextColor3 = Theme.Text, Font = Enum.Font.SourceSansBold, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
		end

		-- Toggle
		function tab:CreateToggle(name, default, callback)
			local val = default or false
			local frame = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = #page:GetChildren()+1})
			Stroke(frame)
			Create("TextLabel", {Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(0.7, 0, 1, 0), Position = UDim2.new(0, 8, 0, 0), Text = name, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			local btn = Create("TextButton", {Parent = frame, BackgroundColor3 = val and Theme.ToggleOn or Theme.ToggleOff, Size = UDim2.new(0, 32, 0, 14), Position = UDim2.new(1, -42, 0.5, -7), Text = "", AutoButtonColor = false})
			Stroke(btn)
			local dot = Create("Frame", {Parent = btn, BackgroundColor3 = Color3.fromRGB(255,255,255), Size = UDim2.new(0, 10, 0, 10), Position = val and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5), BorderSizePixel = 0})
			local function set(v)
				val = v
				local col = v and Theme.ToggleOn or Theme.ToggleOff
				local pos = v and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
				TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = col}):Play()
				TweenService:Create(dot, TweenInfo.new(0.2), {Position = pos}):Play()
				if callback then callback(v) end
			end
			btn.MouseButton1Click:Connect(function() set(not val) end)
			return {Set = set, Get = function() return val end}
		end

		-- Button
		function tab:CreateButton(name, callback)
			local btn = Create("TextButton", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = #page:GetChildren()+1, Text = "", AutoButtonColor = false})
			Stroke(btn)
			Create("TextLabel", {Parent = btn, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = name, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true})
			btn.MouseButton1Click:Connect(function() if callback then callback() end end)
			btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play() end)
			btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Element}):Play() end)
		end

		-- Slider
		function tab:CreateSlider(name, min, max, default, callback)
			min, max = min or 0, max or 100
			local val = default or min
			local dragging = false
			local frame = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = #page:GetChildren()+1})
			Stroke(frame)
			local label = Create("TextLabel", {Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.new(0, 8, 0, 3), Text = name..": "..val, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			local bg = Create("Frame", {Parent = frame, BackgroundColor3 = Color3.fromRGB(20,20,20), Size = UDim2.new(1, -16, 0, 6), Position = UDim2.new(0, 8, 0, 28)})
			local fill = Create("Frame", {Parent = bg, BackgroundColor3 = Theme.SliderFill, Size = UDim2.new((val-min)/(max-min), 0, 1, 0)})
			local dot = Create("TextButton", {Parent = bg, BackgroundColor3 = Color3.fromRGB(255,255,255), Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new((val-min)/(max-min), -5, 0.5, -5), Text = "", AutoButtonColor = false, BorderSizePixel = 0})
			local function upd(px)
				local rel = math.clamp((px - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
				val = math.floor(min + (max-min)*rel)
				fill.Size = UDim2.new(rel, 0, 1, 0)
				dot.Position = UDim2.new(rel, -5, 0.5, -5)
				label.Text = name..": "..val
				if callback then callback(val) end
			end
			dot.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
			bg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then upd(i.Position); dragging = true end end)
			UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i.Position) end end)
			UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
			return {Set = function(v) val = math.clamp(v, min, max); local rel = (val-min)/(max-min); fill.Size = UDim2.new(rel,0,1,0); dot.Position = UDim2.new(rel,-5,0.5,-5); label.Text = name..": "..val end, Get = function() return val end}
		end

		-- Dropdown
		function tab:CreateDropdown(name, options, callback)
			local sel = options[1] or ""
			local open = false
			local btns = {}
			local frame = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = #page:GetChildren()+1, ClipsDescendants = false})
			Stroke(frame)
			local mainBtn = Create("TextButton", {Parent = frame, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 1, 0), Text = "", AutoButtonColor = false})
			local label = Create("TextLabel", {Parent = mainBtn, BackgroundTransparency = 1, Size = UDim2.new(0.85,0,1,0), Position = UDim2.new(0,8,0,0), Text = name..": "..sel, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			local arrow = Create("TextLabel", {Parent = mainBtn, BackgroundTransparency = 1, Size = UDim2.new(0,20,1,0), Position = UDim2.new(1,-25,0,0), Text = ">", TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true})
			local optsFrame = Create("Frame", {Parent = frame, BackgroundColor3 = Theme.Element, Size = UDim2.new(1,0,0,0), Position = UDim2.new(0,0,1,0), ClipsDescendants = true, ZIndex = 10})
			Stroke(optsFrame)
			Create("UIListLayout", {Parent = optsFrame, SortOrder = Enum.SortOrder.LayoutOrder})
			local function rebuild()
				for _, b in ipairs(btns) do b:Destroy() end; btns = {}
				for _, opt in ipairs(options) do
					local ob = Create("TextButton", {Parent = optsFrame, BackgroundColor3 = Theme.Element, Size = UDim2.new(1,0,0,22), Text = opt, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, AutoButtonColor = false, ZIndex = 10})
					ob.MouseButton1Click:Connect(function()
						sel = opt; label.Text = name..": "..opt
						open = false; TweenService:Create(optsFrame, TweenInfo.new(0.15), {Size = UDim2.new(1,0,0,0)}):Play()
						TweenService:Create(arrow, TweenInfo.new(0.15), {Rotation = 0}):Play()
						if callback then callback(opt) end
					end)
					ob.MouseEnter:Connect(function() TweenService:Create(ob, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play() end)
					ob.MouseLeave:Connect(function() TweenService:Create(ob, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Element}):Play() end)
					table.insert(btns, ob)
				end
			end
			mainBtn.MouseButton1Click:Connect(function()
				open = not open
				if open then
					TweenService:Create(optsFrame, TweenInfo.new(0.25), {Size = UDim2.new(1,0,0,#options*22)}):Play()
					TweenService:Create(arrow, TweenInfo.new(0.25), {Rotation = 90}):Play()
				else
					TweenService:Create(optsFrame, TweenInfo.new(0.15), {Size = UDim2.new(1,0,0,0)}):Play()
					TweenService:Create(arrow, TweenInfo.new(0.15), {Rotation = 0}):Play()
				end
			end)
			rebuild()
			return {Set = function(v) sel = v; label.Text = name..": "..v end, Get = function() return sel end, Refresh = function(o) options = o; rebuild() end}
		end

		-- Label
		function tab:CreateLabel(text)
			local frm = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = #page:GetChildren()+1})
			Stroke(frm)
			local lbl = Create("TextLabel", {Parent = frm, BackgroundTransparency = 1, Size = UDim2.new(1, -10, 1, 0), Position = UDim2.new(0, 5, 0, 0), Text = text, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			return {Set = function(t) lbl.Text = t end}
		end

		-- Textbox
		function tab:CreateTextbox(name, placeholder, callback)
			local frm = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = #page:GetChildren()+1})
			Stroke(frm)
			Create("TextLabel", {Parent = frm, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.new(0, 8, 0, 3), Text = name, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			local boxBg = Create("Frame", {Parent = frm, BackgroundColor3 = Color3.fromRGB(20,20,20), Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 0, 22)})
			Stroke(boxBg)
			local box = Create("TextBox", {Parent = boxBg, BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, 0), Position = UDim2.new(0, 4, 0, 0), Text = "", PlaceholderText = placeholder or "", PlaceholderColor3 = Color3.fromRGB(140,140,140), TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, ClearTextOnFocus = false})
			box.FocusLost:Connect(function(enter) if callback and enter then callback(box.Text) end end)
			return {Set = function(t) box.Text = t end, Get = function() return box.Text end}
		end

		-- Keybind
		function tab:CreateKeybind(name, default, callback)
			local key = default or Enum.KeyCode.F
			local binding = false
			local frm = Create("Frame", {Parent = page, BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = #page:GetChildren()+1})
			Stroke(frm)
			Create("TextLabel", {Parent = frm, BackgroundTransparency = 1, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.new(0, 8, 0, 0), Text = name, TextColor3 = Theme.Text, Font = Enum.Font.SourceSans, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left})
			local keyBtn = Create("TextButton", {Parent = frm, BackgroundColor3 = Theme.Accent, Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0.5, -10), Text = key.Name, TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.SourceSansBold, TextScaled = true, AutoButtonColor = false})
			Stroke(keyBtn)
			local function set(k)
				key = k; keyBtn.Text = k.Name
				if callback then callback(k) end
			end
			keyBtn.MouseButton1Click:Connect(function()
				binding = true; keyBtn.Text = "..."
				local conn; conn = UserInputService.InputBegan:Connect(function(input, gp)
					if binding and input.UserInputType == Enum.UserInputType.Keyboard then
						set(input.KeyCode); binding = false
						conn:Disconnect()
					end
				end)
			end)
			return {Set = set, Get = function() return key end}
		end

		return tab
	end

	-- Window API
	local win = {
		Frame = main,
		ScreenGui = screenGui,
		CreateTab = CreateTab,
		Notify = Notify,
		SetTheme = function(themeTable)
			if themeTable then
				for k, v in pairs(themeTable) do
					Theme[k] = v
				end
			end
		end
	}

	-- Built-in Settings tab
	local settings = CreateTab("Settings", "⚙")
	settings:CreateSection("Info")
	settings:CreateLabel("ClassicUI v" .. ClassicUI.Version)
	settings:CreateLabel("Author: " .. ClassicUI.Author)
	settings:CreateToggle("Show UI", true, function(v) main.Visible = v end)

	ClassicUI.ActiveWindow = win
	return win
end

return ClassicUI
