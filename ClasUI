			TabHolder = tabHolder,
			ContentFrame = contentFrame,
			NotificationSystem = notificationSystem,
			Console = console,
			ScreenGui = screenGui
		}

		function window:CreateTab(tabName, tabIcon)
			return CreateTab(window, tabName, tabIcon)
		end

		function window:Notify(title, message, duration)
			notificationSystem.Send(title, message, duration)
		end

		function window:SetTheme(themeName)
			local theme = ClassicUI.Themes[themeName]
			if theme then
				ActiveTheme = theme
				-- Reapply theme to all elements (simplified)
				window.Frame.BackgroundColor3 = theme.WindowBackground
				-- etc., but we'll just notify for now
				notificationSystem.Send("Theme", "Changed to " .. theme.Name, 2)
			end
