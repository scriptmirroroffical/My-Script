ToggleBtn.MouseButton1Click:Connect(function()
    IsOn = not IsOn
    ESP_SETTINGS.Enabled = IsOn
    ToggleBtn.Text = IsOn and "ESP ON" or "ESP OFF"
    ToggleBtn.BackgroundColor3 = IsOn and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(0, 255, 255)
end)

